name: Mettre à jour la liste des photos

on:
  push:
    branches: [main]
    paths: ["photos/**"]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  liste:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Générer photos.json
        run: |
          python3 - <<'EOF'
          import json, os
          ext = (".jpg", ".jpeg", ".png", ".webp", ".avif", ".gif", ".svg")
          files = sorted(
              "photos/" + f for f in os.listdir("photos")
              if f.lower().endswith(ext) and not f.startswith(".")
          )
          with open("photos.json", "w", encoding="utf-8") as out:
              json.dump(files, out, ensure_ascii=False, indent=1)
          print(len(files), "photos listées")
          EOF

      - name: Enregistrer la liste
        run: |
          git config user.name "github-actions"
          git config user.email "github-actions@users.noreply.github.com"
          git add photos.json
          git diff --cached --quiet || (git commit -m "Mise à jour de la liste des photos" && git push)
